# ─── Nova environment (copy to .env; real secrets live in Coolify, never in git) ───

# --- Core service ---
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO
NOVA_TIMEZONE=Europe/Amsterdam

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
NOVA_MODEL=qwen2.5:7b
NOVA_EMBED_MODEL=nomic-embed-text

# --- Database (Postgres + pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-in-coolify

# --- Household identity: map channel identity -> user ---
# WhatsApp sender numbers in E.164 (no +), comma-separated "number:name"
NOVA_WHATSAPP_USERS=31600000001:Ruben,31600000002:Meral

# --- WhatsApp (Meta Cloud API) — Phase 4 ---
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Telegram Bot (Phase 20) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NOVA_TELEGRAM_ENABLED=false
NOVA_TELEGRAM_USERS=123456789:Ruben,987654321:Meral

# --- Email (IMAP + SMTP, replaces MS Graph) — Phase 38 ---
NOVA_DOMAIN=                      # e.g., 7rb.nl — no default; must be set
NOVA_IMAP_HOST=                   # IMAP server hostname
NOVA_IMAP_PORT=993                # IMAPS port
NOVA_IMAP_USER=nova               # mailbox user
NOVA_IMAP_PASS=change-me          # mailbox password
NOVA_IMAP_USE_SSL=true            # connect via SSL (993)
NOVA_SMTP_HOST=                   # SMTP relay hostname
NOVA_SMTP_PORT=587                # STARTTLS port
NOVA_SMTP_USER=nova               # SMTP auth user
NOVA_SMTP_PASS=change-me          # SMTP auth password
NOVA_SMTP_USE_TLS=true            # negotiate STARTTLS (587)

# --- Observability: OpenObserve (hosted as a Coolify service) ---
# OPENOBSERVE_URL is the public URL Coolify exposes (Traefik on port 80 behind
# a sslip.io host). It is only used for the ops-bridge / dashboards; Vector
# talks to OpenObserve directly on the LAN via OPENOBSERVE_HOST + /etc/hosts.
OPENOBSERVE_URL=http://openobserve.local:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me
# Bare hostname Vector uses; the container's /etc/hosts pins this to
# OPENOBSERVE_LAN_IP so we never hairpin the public IP from inside the LAN.
OPENOBSERVE_HOST=openobserve.local
OPENOBSERVE_LAN_IP=192.168.3.110

# --- Incident intake: Forgejo issues (ops-bridge + ops scripts) ---
FORGEJO_URL=https://git.7rb.nl
FORGEJO_REPO=ruben/nova
FORGEJO_TOKEN=                          # Forgejo → Settings → Applications → token (issue rw)
BRIDGE_TOKEN=change-me                  # shared secret OpenObserve must send as X-Bridge-Token

# --- Scheduled Maintenance Agent (Phase 29) ---
# Forgejo issue tracking for maintenance findings
FORGEJO_URL=https://git.7rb.nl
FORGEJO_REPO=ruben/nova
FORGEJO_TOKEN=                          # token with issue read/write on the repo

# Maintenance agent toggles (all default ON)
MAINTENANCE_ENABLED=true
MAINTENANCE_DEP_CHECK_ENABLED=true
MAINTENANCE_LOG_ANOMALY_ENABLED=true
MAINTENANCE_BACKUP_VERIFY_ENABLED=true
MAINTENANCE_TREND_REPORT_ENABLED=true

# Backup verification (path to directory with pg_dump files)
BACKUP_DUMP_DIR=/backups/postgres
BACKUP_DUMP_PATTERN=nova-*.sql

# --- CalDAV (self-hosted calendar) — Phase 5 ---
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
