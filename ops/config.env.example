# ─── Nova ops loop configuration (copy to ops/config.env; never commit the real one) ───

# Coolify instance (runs on the Nova AI VM)
COOLIFY_URL=http://coolify.local:8000
COOLIFY_API_TOKEN=change-me            # Coolify → Keys & Tokens → API tokens

# Coolify resource UUIDs (Coolify UI → resource → UUID in the URL)
# Comma-separated "name:uuid" pairs — one per deployable service.
NOVA_SERVICES=nova-core:REPLACE_UUID,caddy:REPLACE_UUID

# Staging services (comma-separated "name:uuid" pairs)
# Coolify resource UUIDs for the staging stack.
# These are separate Coolify resources pointing at docker-compose.staging.yml.
STAGING_SERVICES=nova-staging:REPLACE_UUID

# Production services (comma-separated "name:uuid" pairs)
# Separate from staging so deploy.sh can target each independently.
PROD_SERVICES=nova-core:REPLACE_UUID,caddy:REPLACE_UUID

# When STAGING_SERVICES or PROD_SERVICES is not set, falls back to NOVA_SERVICES.
# NOVA_SERVICES can remain as the production list for backward compatibility.

# Health endpoints to verify after a deploy ("name:url", comma-separated).
NOVA_HEALTH_CHECKS=nova-core:http://nova.local:8080/health,nova-staging:http://nova-staging.local:8081/health

# Staging health endpoint (used by promote.sh to verify staging is running).
STAGING_HEALTH_URL=http://nova-staging.local:8081/health

# Deploy verification
DEPLOY_TIMEOUT_SECONDS=600             # max wait for a Coolify deployment to finish
HEALTH_RETRIES=10                      # health poll attempts after deploy
HEALTH_INTERVAL_SECONDS=15             # seconds between health polls
LOG_TAIL_LINES=200                     # container log lines captured into incidents

# Incident queue: Forgejo issues (source of truth)
FORGEJO_URL=https://git.7rb.nl
FORGEJO_REPO=ruben/nova
FORGEJO_TOKEN=change-me                # token with issue read/write on the repo

# Self-healing (Claude Code headless)
HEAL_ENABLED=true
HEAL_MAX_ATTEMPTS=2                    # heal→redeploy cycles per pipeline run
HEAL_BRANCH_PREFIX=nova/heal           # fixes land on nova/heal-<timestamp>
HEAL_AUTO_PUSH=false                   # true: push fix branch (or main) to trigger redeploy
HEAL_PUSH_TO_MAIN=false                # true + AUTO_PUSH: fully autonomous loop (use with care)
CLAUDE_MODEL=                          # empty = Claude Code default; or e.g. claude-opus-4-8
CLAUDE_MAX_TURNS=40

#
# ─── Model Benchmarking Workflow (Phase 28 / D-06) ──────────────────────────
#
# 1. Set a different NOVA_MODEL in .env.staging (vs .env production)
#    Example: Staging runs "qwen3:32b" while production runs "qwen3:14b"
#
# 2. Deploy staging: ops/deploy.sh --staging  (default)
#    Coolify picks up docker-compose.staging.yml and deploys nova-staging
#
# 3. Run evals against staging:
#    curl -X POST http://nova-staging.local:8081/v1/chat/completions \
#      -H "Content-Type: application/json" \
#      -d '{"messages":[{"role":"user","content":"..."}]}'
#
# 4. Compare before/after:
#    - Phase 26 tracing emits structured traces to OpenObserve from both
#      staging and production (same OPENOBSERVE_* config)
#    - Query OpenObserve agent_traces stream for both:
#        {channel="nova-staging"} vs {channel="nova-core"} (or filter by user)
#    - Compare: p95 latency, token_count, tool call error rate
#
# 5. Benchmark report:
#    Run ops/promote.sh to gate staging→production only when:
#    - Test suite passes (pytest)
#    - Evals pass (test_evals.py)
#    - Manual comparison of tracing metrics is satisfactory
#
# Tracing-based comparison (D-06):
#   Both stacks emit to the same OpenObserve instance. To compare models:
#   - Use the OpenObserve UI or API to query agent_traces
#   - Filter by time range (staging deploy time vs production baseline)
#   - Key metrics: latency_ms avg/p95, token_count avg, got_stuck ratio
#   - If staging's model degrades metrics, roll back before promoting
