# ─── Nova ops loop configuration (copy to ops/config.env; never commit the real one) ───

# Coolify instance (runs on the Nova AI VM)
COOLIFY_URL=http://coolify.local:8000
COOLIFY_API_TOKEN=change-me            # Coolify → Keys & Tokens → API tokens

# Coolify resource UUIDs (Coolify UI → resource → UUID in the URL)
# Comma-separated "name:uuid" pairs — one per deployable service.
NOVA_SERVICES=nova-core:REPLACE_UUID,caddy:REPLACE_UUID

# Health endpoints to verify after a deploy ("name:url", comma-separated).
NOVA_HEALTH_CHECKS=nova-core:http://nova.local:8080/health

# Deploy verification
DEPLOY_TIMEOUT_SECONDS=600             # max wait for a Coolify deployment to finish
HEALTH_RETRIES=10                      # health poll attempts after deploy
HEALTH_INTERVAL_SECONDS=15             # seconds between health polls
LOG_TAIL_LINES=200                     # container log lines captured into incidents

# Incident queue: Forgejo issues (source of truth)
FORGEJO_URL=https://git.7rb.nl
FORGEJO_REPO=ruben/nova
FORGEJO_TOKEN=change-me                # token with issue read/write on the repo

# Self-healing (Claude Code headless)
HEAL_ENABLED=true
HEAL_MAX_ATTEMPTS=2                    # heal→redeploy cycles per pipeline run
HEAL_BRANCH_PREFIX=nova/heal           # fixes land on nova/heal-<timestamp>
HEAL_AUTO_PUSH=false                   # true: push fix branch (or main) to trigger redeploy
HEAL_PUSH_TO_MAIN=false                # true + AUTO_PUSH: fully autonomous loop (use with care)
CLAUDE_MODEL=                          # empty = Claude Code default; or e.g. claude-opus-4-8
CLAUDE_MAX_TURNS=40
