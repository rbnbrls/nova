# ─── Infra provisioning credentials — copy to ops/secrets/infra.env ───
# This whole directory is gitignored except this template. Never commit the real file.

# --- Proxmox ---
PROXMOX_HOST=192.168.1.50              # bare host/IP, no scheme (used for SSH)
PROXMOX_API_URL=https://192.168.1.50:8006/api2/json
PROXMOX_NODE=pve                       # node name shown in the Proxmox UI
PROXMOX_API_INSECURE=true              # true if using the default self-signed cert

# API token: Datacenter -> Permissions -> API Tokens -> Add
#   User: root@pam (or a dedicated "nova-provisioner@pve" user — see note below)
#   Token ID: nova
#   Uncheck "Privilege Separation" only if you want it to inherit the user's
#   full rights; otherwise assign a role (e.g. PVEVMAdmin) to the token itself.
PROXMOX_API_TOKEN_ID=root@pam!nova
PROXMOX_API_TOKEN_SECRET=

# SSH — optional but strongly recommended for the read-only audit script.
# IOMMU/kernel-cmdline/PCI-group checks aren't reliably exposed via the API
# alone, especially on older Proxmox versions. Use a dedicated key, not your
# personal one.
PROXMOX_SSH_USER=root
PROXMOX_SSH_PORT=22
PROXMOX_SSH_KEY_PATH=~/.ssh/nova_proxmox_ed25519

# --- Coolify ---
# Same token works for both the ops loop (ops/config.env) and provisioning
# (creating new resources/apps) as long as it has admin scope.
COOLIFY_URL=http://coolify.local:8000
COOLIFY_API_TOKEN=
